# --- Required to run (Gemini API key path) ---
GOOGLE_API_KEY=your_google_api_key_here
# Set TRUE to use Vertex AI ADC instead of an API key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Phase 19: deploy environment ---
# APP_ENV=local
# staging/production require Postgres DATABASE_URL + API_KEY + Gemini/Vertex
# APP_ENV=staging
# APP_ENV=production

# --- Phase 22/23: vertical pack (PACK_ID selects live graph) ---
# PACK_ID=youtube_shorts
# PACK_ID=sales_brief

# --- Optional (safe defaults in config) ---
# MODEL_NAME=gemini-2.0-flash-001
# Phase 14: per-task overrides (empty → MODEL_NAME)
# MODEL_RESEARCH=gemini-2.0-flash-001
# MODEL_WRITE=gemini-2.0-flash-001
# MODEL_EVALUATE=gemini-2.0-flash-001
# MODEL_VISUALIZE=gemini-2.0-flash-001
# MODEL_FORMAT=gemini-2.0-flash-001
# MODEL_FALLBACK=gemini-2.0-flash-001
# APP_NAME=youtube_shorts_app
# LOG_LEVEL=INFO
# QUALITY_THRESHOLD=7.0

# --- Phase 6: LLM call resilience (live judge / future live nodes) ---
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_ATTEMPTS=3
# LLM_BACKOFF_BASE_SECONDS=0.5
# LLM_BACKOFF_MAX_SECONDS=8
# LIVE_JUDGE_FALLBACK=true

# --- Phase 9: Observability ---
# LOG_PAYLOADS=false
# COST_PER_1M_INPUT_USD=0.10
# COST_PER_1M_OUTPUT_USD=0.40
# ENABLE_OTEL=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# (OTel soft deps: opentelemetry-api/sdk/exporter-otlp)

# --- Phase 10: Persistence ---
# DATABASE_URL=sqlite+pysqlite:///./data/shorts.db
# Compose local-db default:
# DATABASE_URL=postgresql+psycopg://shorts:shorts@localhost:5432/shorts
# CHECKPOINT_BACKEND=memory
# CHECKPOINT_POSTGRES_URL=postgresql://shorts:shorts@localhost:5432/shorts
# SESSION_DB_URL=   # deprecated alias for DATABASE_URL

# --- Phase 11: Long-term memory / RAG (not CHECKPOINT_BACKEND) ---
# MEMORY_RETRIEVAL=true
# MEMORY_TOP_K=3
# MEMORY_MAX_CONTEXT_CHARS=1500
# MEMORY_WRITE_MIN_SCORE=7.0
# MEMORY_RETENTION_DAYS=180

# --- Phase 12: MCP shorts_catalog (tools — not A2A) ---
# MCP_SHORTS_CATALOG_ENABLED=true
# MCP_TOOL_TIMEOUT_SEC=5
# MCP_ALLOWED_TOOLS=list_recent_shorts,search_shorts,get_short

# --- Phase 13: Human-in-the-loop (default off so CI/eval never hang) ---
# HITL_REQUIRED=false
# MAX_HUMAN_ROUNDS=2

# --- Phase 15: A2A Research Agent (default off — CI stays single-process) ---
# A2A_RESEARCH_ENABLED=false
# A2A_RESEARCH_URL=http://127.0.0.1:9101
# A2A_TIMEOUT_SEC=30
# A2A_RESEARCH_REQUIRED=false

# --- Phase 16: Async API + worker ---
# API_KEY=dev-change-me
# API_KEYS=optional-extra-key-1,optional-extra-key-2
# WORKER_POLL_SEC=1
# JOB_MAX_ATTEMPTS=3

# --- Phase 17: Security / guardrails ---
# API_RATE_LIMIT_PER_MIN=30
# JOB_TIMEOUT_SEC=300
# FORCE_HITL_ON_INJECTION=true
# OUTPUT_POLICY_ENABLED=true

# --- Advanced ---
# MAX_INPUT_LENGTH=2000
