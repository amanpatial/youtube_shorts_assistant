# --- Required to run (Gemini API key path) ---
GOOGLE_API_KEY=your_google_api_key_here
# Set TRUE to use Vertex AI ADC instead of an API key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Optional (safe defaults in config) ---
# MODEL_NAME=gemini-2.0-flash-001
# APP_NAME=youtube_shorts_app
# LOG_LEVEL=INFO
# QUALITY_THRESHOLD=7.0

# --- Phase 6: LLM call resilience (live judge / future live nodes) ---
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_ATTEMPTS=3
# LLM_BACKOFF_BASE_SECONDS=0.5
# LLM_BACKOFF_MAX_SECONDS=8
# LIVE_JUDGE_FALLBACK=true

# --- Phase 9: Observability ---
# LOG_PAYLOADS=false
# COST_PER_1M_INPUT_USD=0.10
# COST_PER_1M_OUTPUT_USD=0.40
# ENABLE_OTEL=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# (OTel soft deps: opentelemetry-api/sdk/exporter-otlp)

# --- Phase 10: Persistence ---
# DATABASE_URL=sqlite+pysqlite:///./data/shorts.db
# CHECKPOINT_BACKEND=memory
# CHECKPOINT_POSTGRES_URL=postgresql://shorts:shorts@localhost:5432/shorts
# SESSION_DB_URL=   # deprecated alias for DATABASE_URL

# --- Advanced ---
# MAX_INPUT_LENGTH=2000
